{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"incremental": false,
		"types": ["node", "vitest/globals"]
	},
	"include": [
		"packages/katala/core/**/*.ts",
		"packages/katala/gateway/**/*.ts",
		"packages/katala/proto/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"packages/katala/mediation-client",
		"packages/katala/core/test-synergy.ts",
		"packages/katala/gateway/PythonInfCodingAdapter.ts",
		"packages/katala/gateway/index.ts"
	]
}
